# Copy to .env and fill in. Anything left blank runs in demo mode:
# no Stripe key = payments simulated, no SMTP = emails saved to data/outbox.json.
PORT=3000
SITE_URL=http://localhost:3000
# Set to 1 when hosted behind a proxy (Render, Railway, Heroku...) so recorded IP addresses are correct
TRUST_PROXY=

# Folder for bookings, verifications and uploaded documents. Use a persistent disk in production (e.g. /var/data).
DATA_DIR=

# Password for the staff page at /admin (any username). Use a long, unique password.
ADMIN_PASSWORD=

# ---- Payments (Stripe) ----
# From https://dashboard.stripe.com/apikeys (use sk_test_... while testing)
STRIPE_SECRET_KEY=
# From `stripe listen --forward-to localhost:3000/api/stripe/webhook` or the Dashboard webhook page
STRIPE_WEBHOOK_SECRET=
CURRENCY=gbp
# Share of the hire total taken to reserve when the customer chooses "Reserve with 25%"
DEPOSIT_PERCENT=25

# ---- Email (any SMTP provider: Google Workspace, Outlook/Microsoft 365, Zoho, SendGrid, Resend...) ----
SMTP_HOST=
SMTP_PORT=587
# true for port 465
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=BG LUX <bookings@your-domain.com>
# Where new booking, enquiry, verification and deposit alerts are sent (defaults to CONTACT_EMAIL)
BUSINESS_EMAIL=

# ---- Contact details shown across the site ----
CONTACT_PHONE=+44 0000 000000
# WhatsApp number in international format, digits only (e.g. 447700900000)
CONTACT_WHATSAPP=440000000000
CONTACT_EMAIL=info@example.com
CONTACT_INSTAGRAM=https://instagram.com/
