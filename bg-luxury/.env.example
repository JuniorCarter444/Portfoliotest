# Copy to .env and fill in. Without STRIPE_SECRET_KEY the site runs in demo mode
# (bookings are saved but no card is charged).
PORT=3000
SITE_URL=http://localhost:3000

# From https://dashboard.stripe.com/apikeys (use sk_test_... while testing)
STRIPE_SECRET_KEY=
# From `stripe listen --forward-to localhost:3000/api/stripe/webhook` or the Dashboard webhook page
STRIPE_WEBHOOK_SECRET=

CURRENCY=gbp
# Share of the rental total taken to reserve when the customer chooses "Pay deposit"
DEPOSIT_PERCENT=25

# Contact details shown across the site (Call to book, WhatsApp, footer)
CONTACT_PHONE=+44 0000 000000
# WhatsApp number in international format, digits only (e.g. 447700900000)
CONTACT_WHATSAPP=440000000000
CONTACT_EMAIL=info@example.com
CONTACT_INSTAGRAM=https://instagram.com/
